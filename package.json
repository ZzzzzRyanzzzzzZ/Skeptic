{
  "name": "skeptic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline, explainable scam and phishing detection that runs entirely in your browser.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b --noEmit && vite build",
    "check": "tsx bin/skeptic.ts",
    "dev": "vite",
    "eval:external": "node scripts/fetch-external.mjs && tsx ml/evaluate-external.ts",
    "fetch:external": "node scripts/fetch-external.mjs",
    "prebuild": "node scripts/vendor-ocr.mjs",
    "predev": "node scripts/vendor-ocr.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-ocr.mjs",
    "test:watch": "vitest",
    "train": "tsx ml/train.ts",
    "typecheck": "tsc -b --noEmit",
    "vendor:ocr": "node scripts/vendor-ocr.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  }
}
